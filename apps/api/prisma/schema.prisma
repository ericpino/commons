generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model audit {
  id         BigInt   @id @default(autoincrement())
  actor_id   String?
  action     String
  record_id  String?
  team_id    String?
  detail     Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model follows {
  user_id String
  team_id String
  teams   teams  @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, team_id])
}

model joins {
  user_id   String
  record_id String
  records   records @relation(fields: [record_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users     users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, record_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model records {
  id          String    @id
  kind        String
  title       String
  body        String    @default("")
  team_id     String?
  visibility  String
  owner_id    String?
  data        Json      @default("{}")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  archived_at DateTime? @db.Timestamptz(6)
  joins       joins[]
  users       users?    @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teams       teams?    @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([kind], map: "records_kind")
}

model sessions {
  token      String   @id
  user_id    String?
  expires_at DateTime @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model skills {
  id   BigInt @id @default(autoincrement())
  name String @unique
}

model teams {
  id          String    @id
  name        String
  mission     String
  archived_at DateTime? @db.Timestamptz(6)
  follows     follows[]
  records     records[]
  users       users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id          String     @id
  name        String
  title       String
  role        String
  team_id     String?
  skills      String[]   @default([])
  archived_at DateTime?  @db.Timestamptz(6)
  audit       audit[]
  follows     follows[]
  joins       joins[]
  records     records[]
  sessions    sessions[]
  teams       teams?     @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
